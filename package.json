    "@astrojs/tailwind": "^6.0.2",
    "@fancyapps/ui": "^6.0.21",
    "@iconify/react": "^6.0.2",
    "@playform/compress": "^0.1.9",
    "@tailwindcss/typography": "^0.5.16",
    "astro": "^5.9.0",
    "astro-icon": "^1.1.5",
    "astro-vtbot": "^2.1.3",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
