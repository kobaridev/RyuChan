    "astro": "astro",
    "deploy": "pnpm build && wrangler pages deploy dist",
    "deploy:worker": "pnpm build:worker && wrangler deploy",
    "preview:worker": "pnpm build:worker && wrangler dev",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
