{
  "name": "ryuchan",
  "type": "module",
  "version": "2.0.0",
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "prefetch:music": "node scripts/fetch-music-duration.mjs",
    "prebuild": "node scripts/prebuild-content.mjs && node scripts/fetch-music-duration.mjs --progress",
    "build": "astro build && npx pagefind --site ./dist",
