# GitHub App Configuration（前端仓，用于 /write /config 在线编辑）
# Get these values from your GitHub App settings
PUBLIC_GITHUB_OWNER=kobaridev
PUBLIC_GITHUB_REPO=RyuChan
PUBLIC_GITHUB_BRANCH=main
PUBLIC_GITHUB_APP_ID=
PUBLIC_GITHUB_ENCRYPT_KEY=

# ─── 内容仓（RyuChan-Content）克隆凭据 ──────────────────────
# 内容仓为私有时必须配置，GitHub Actions 会自动注入 GITHUB_TOKEN
# 本地开发时如需 clone 私有内容仓，填入 Personal Access Token（repo scope）
CONTENT_REPO_OWNER=kobaridev
CONTENT_REPO_NAME=RyuChan-Content
CONTENT_REPO_BRANCH=main
CONTENT_TOKEN=

# ─── 可选：本地开发时指定内容仓路径（覆盖自动 clone）─────────
# CONTENT_REPO=/path/to/ryuchan-content

